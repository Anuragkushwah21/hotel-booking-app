# Copy to .env (local) or set in your host's environment settings.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/database
# Neon: same URL WITHOUT "-pooler" in the host. Used by prisma migrate/studio,
# which need session-level locks the pooler can't hold reliably.
DIRECT_URL=

# --- Secrets (REQUIRED in production) -------------------------------------------
# Signs guest booking-access cookies and hashes OTPs. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs every guest out of their booking pages and voids pending codes.
SESSION_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/maintenance.
CRON_SECRET=

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=HotelBook
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: WhatsApp support button (digits with country code). Falls back to lib/hotel.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Online payments — Razorpay (INR: UPI, cards, netbanking) -----------------
# Without keys a MOCK "test mode" gateway is used outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks: URL {APP_URL}/api/payments/webhook,
# events payment.captured + payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Allow the MOCK gateway in production (staging only — never on a live site)
PAYMENT_ALLOW_MOCK=false

# --- Email (booking emails, OTPs, password links). Defaults to Gmail. ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=
EMAIL_USER=
# Gmail: an app password from https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# --- OTP ------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- WhatsApp notifications (optional; messages stay PENDING until set) --------
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
