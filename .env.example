# # Database
# DATABASE_URL=postgresql://[user]:[password]@[host]/[database]

# # Online payments — Razorpay (INR: UPI, cards, netbanking)
# # Without these keys a MOCK "test mode" gateway is used outside production,
# # so the booking → payment → auto-confirm flow can be tried locally.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret
# # Dashboard → Settings → Webhooks: URL {APP_URL}/api/payments/webhook,
# # events payment.captured + payment.failed
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# # Allow the MOCK gateway in production (staging only — never on a live site)
# PAYMENT_ALLOW_MOCK=false

# # WhatsApp notifications (optional; messages stay PENDING in the log until set)
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=your_permanent_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_sender_phone_number_id

# # SMTP (booking emails + OTP). Defaults to Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM_EMAIL=stay@yourhotel.com

# # Email Configuration (for Gmail - https://myaccount.google.com/apppasswords)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_specific_password
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# # Auth (Optional - add if implementing session secret)
# SESSION_SECRET=your_random_secret_key_here
# BOOKING_ACCESS_SECRET=another_long_random_server_only_value

# # Node Environment
# NODE_ENV=development
